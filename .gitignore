# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
# estimator suite output: JSON reports + per-story screenshots
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# Playwright MCP browser artifacts
.playwright-mcp/

# Blog regeneration working dirs (CI artifacts, never committed)
regen-backups/
regen-preview/

.env*.local

# Claude Code: local settings and the Impeccable engine binary (downloaded at install, ~20 MB)
.claude/settings.local.json
.claude/skills/impeccable/scripts/bin/

# Throwaway probe/debug scripts and local settings backups
*.tmp.mjs
*.tmp.cjs
*.tmp.ts
.claude/settings.local.json.bak*
